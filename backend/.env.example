# ---- App ----
NODE_ENV=development
PORT=3333
# Production: đổi thành domain của frontend, vd https://clb-cau-long.vercel.app
CORS_ORIGINS=http://localhost:3000

# ---- Supabase ----
# Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# Chỉ dùng ở backend, KHÔNG bao giờ để lộ ra frontend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Backend verify token qua JWKS: <SUPABASE_URL>/auth/v1/.well-known/jwks.json
# nên KHÔNG cần khai báo gì thêm nếu project dùng JWT Signing Keys (ECC/RSA).
#
# Chỉ điền biến dưới đây nếu project vẫn ký HS256 bằng Legacy JWT Secret
# (Settings > JWT Keys > tab "Legacy JWT Secret").
# SUPABASE_JWT_SECRET=

# ---- Database (Project Settings > Database > Connection string) ----
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
#
# Production trên Vercel: BẮT BUỘC dùng Transaction Pooler (port 6543),
# KHÔNG dùng Direct connection (5432) — serverless sẽ làm cạn connection.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SSL=false
DATABASE_LOGGING=false
# Serverless (Vercel) = 1. Server long-running (VPS/Fly) = 10.
DATABASE_POOL_MAX=10
